modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["revenuecat:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 8082
externalPort = 3001

[[ports]]
localPort = 8083
externalPort = 5000

[[ports]]
localPort = 8090
externalPort = 3003

[[ports]]
localPort = 9005
externalPort = 4200

[[ports]]
localPort = 9006
externalPort = 5173

[[ports]]
localPort = 9007
externalPort = 6000

[[ports]]
localPort = 25933
externalPort = 3000

[[ports]]
localPort = 25934
externalPort = 3002

[nix]
channel = "stable-25_05"
packages = ["firebase-tools"]

[userenv]

