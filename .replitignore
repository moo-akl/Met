# The format of this file is identical to `.dockerignore`.
# It is used to reduce the size of deployed images to make the process of publishing faster.

# No need to store the pnpm store twice.
.local

# Never include uploaded Firebase Admin private keys in published images.
attached_assets/*firebase-adminsdk*.json

# Research evidence is not part of the running application.
research/sources/
research/notes.md
research/venue-prospects-new-100.json

# Generated deliverables should not be included in published app images.
generated-artifacts/
