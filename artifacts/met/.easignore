# Files in here are excluded from the EAS build upload tarball.
# Anything not strictly needed at build time should go here.

# Replit / monorepo workflow output
server/
static-build/
scripts/

# Local dev artifacts
.expo/
web-build/
dist/

# Logs
*.log
npm-debug.log*

# Editor
.vscode/
.idea/
.DS_Store

# Local env files (EAS uses its own secrets via `eas secret`)
.env
.env.local
.env.*.local
