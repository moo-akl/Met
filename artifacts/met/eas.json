{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "local",
    "requireCommit": false
  },
  "build": {
    "base": {
      "node": "20.18.0",
      "env": {
        "NPM_CONFIG_NODE_LINKER": "hoisted",
        "NPM_CONFIG_SHAMEFULLY_HOIST": "true"
      }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "ios": {
        "image": "latest",
        "simulator": true
      },
      "android": {
        "image": "latest",
        "buildType": "apk"
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "channel": "preview",
      "ios": {
        "image": "latest",
        "simulator": true
      },
      "android": {
        "image": "latest",
        "buildType": "apk"
      }
    },
    "preview:device": {
      "extends": "base",
      "distribution": "internal",
      "channel": "preview",
      "ios": {
        "image": "latest"
      },
      "android": {
        "image": "latest",
        "buildType": "apk"
      }
    },
    "production": {
      "extends": "base",
      "channel": "production",
      "autoIncrement": false,
      "ios": {
        "image": "latest"
      },
      "android": {
        "image": "latest",
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleTeamId": "AWHU9BTQQX",
        "ascAppId": "6764364926"
      },
      "android": {
        "track": "internal"
      }
    }
  }
}
