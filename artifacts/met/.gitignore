# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
ios/
android/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# Firebase config files: intentionally TRACKED so EAS Build can include
# them in the iOS/Android bundles. These contain project identifiers
# (API key, sender ID, bundle ID) — the keys are scoped to bundle ID +
# SHA fingerprint at the Firebase project level, so committing them is
# safe and matches Firebase's official guidance.

# typescript
*.tsbuildinfo
.vercel

.env
