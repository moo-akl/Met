{
  "name": "met-functions",
  "version": "1.0.0",
  "description": "Firebase Cloud Functions for Met — mirrors Firestore reveal status changes into the Postgres source of truth.",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.0.0",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/pg": "^8.18.0",
    "typescript": "^5.6.0"
  },
  "overrides": {
    "websocket-driver": "0.7.5",
    "@grpc/grpc-js": "1.14.5",
    "form-data@^2.0.0": "2.5.6",
    "protobufjs": "7.6.5",
    "uuid": "11.1.1"
  }
}
