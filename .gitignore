# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Replit
.cache/
.local/

# Private keys / secrets — never commit
*.p8
*.p12
*.pem
*.key
.secrets/

# Firebase credentials — server-side credentials must never be committed
firebase-sa.json
# Mobile Firebase configs (google-services.json / GoogleService-Info.plist) are
# client-side identifiers safe to commit; security is enforced by Firestore rules.
# Ignore everywhere EXCEPT the Expo app where they are required at build time.
google-services.json
GoogleService-Info.plist
!artifacts/met/google-services.json
!artifacts/met/GoogleService-Info.plist

# attached_assets — user-pasted files including credentials and build artefacts
# Individual screenshots under attached_assets/screenshots/ are safe but the
# top-level files often contain Firebase service-account JSON, google-services
# configs, and binary build outputs that must never reach a public repo.
attached_assets/*.json
attached_assets/*.plist
attached_assets/*.aab
attached_assets/*.ipa
attached_assets/*.jks
attached_assets/*.jfif
attached_assets/*.txt
attached_assets/*.dart
