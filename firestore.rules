rules_version = '2';

// Met — Firestore security rules.
//
// Source-of-truth identity is Firebase Auth (request.auth.uid).
// All client writes that touch another user's data go through the
// api-server using the Admin SDK (which bypasses these rules).
//
// In production we require a valid App Check token on every request.
// During development we relax that check via a project env var.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthed() { return request.auth != null; }
    function isOwner(userId) { return isAuthed() && request.auth.uid == userId; }

    // App Check: every read / write must carry a valid App Check token.
    // The mobile client initialises App Check at boot via
    // `lib/firestore/client.ts` (debug provider in __DEV__, Play
    // Integrity / App Attest in release), so dev and production both
    // satisfy this gate.
    function isVerifiedApp() {
      return request.app_check_token != null;
    }

    // ------------------------------------------------------------
    //  users/{userId}
    // ------------------------------------------------------------
    // Profile doc. Mirrored from Postgres by the api-server when the
    // user updates their profile, OR self-updated by the client for
    // mutable fields (location, lastActive, isVisible).
    match /users/{userId} {
      // Read: only if the target user has Ghost Mode off, or it's self.
      // Note: any visible profile is currently readable by any authed
      // user (the geohash range query needs broad reads). Sensitive
      // fields like `socials` and `bio` are still in this doc — a
      // future hardening pass should split the doc into a public
      // `presence` subset (uid, geohash, isVisible) and a private
      // `profile` subset gated on a per-pair handshake.
      allow read: if isAuthed() && isVerifiedApp() && (
        resource.data.isVisible == true || isOwner(userId)
      );

      // Create: only the user themselves, and the doc must contain at
      // least a uid that matches.
      allow create: if isOwner(userId) && isVerifiedApp() &&
        request.resource.data.uid == userId;

      // Update: owner only, and certain immutable fields cannot change.
      allow update: if isOwner(userId) && isVerifiedApp() &&
        request.resource.data.uid == resource.data.uid;

      // Delete: never from client. Use api-server admin path.
      allow delete: if false;

      // ----------------------------------------------------------
      //  users/{userId}/met_people/{otherUid}
      // ----------------------------------------------------------
      // Encounter history. Reads are owner-only.
      //
      // Create / update: server-only (api-server via Admin SDK writes
      // these when two users actually cross paths — the client doesn't
      // get to fabricate met_people docs).
      //
      // Delete: allowed for EITHER party. This is the resilience path
      // for Remove / Block — when user A removes user B, A wipes both
      // sides' met_people docs in a single client batch so B's
      // encounter list updates immediately even if the api-server is
      // slow / unreachable. Mirrors the legacy Flutter app's batch.
      match /met_people/{otherUid} {
        allow read: if isOwner(userId) && isVerifiedApp();
        allow create, update: if false;
        allow delete: if isVerifiedApp() && isAuthed() && (
          request.auth.uid == userId || request.auth.uid == otherUid
        );
      }

      // ----------------------------------------------------------
      //  users/{userId}/requests/{otherUid}
      // ----------------------------------------------------------
      // Reveal-request handshake. Reads are owner-only.
      //
      // Writes:
      // - The api-server (Admin SDK) bypasses these rules and is still
      //   the canonical writer for full-fidelity mirrors.
      // - From the client we ALSO allow either party to update the doc:
      //     * the owner (userId) — for their own outbox/inbox doc, AND
      //     * the OTHER party (otherUid) — so the recipient can flip the
      //       sender's outbox doc to "accepted" / "declined" without a
      //       server round-trip. This is the resilience path that makes
      //       accept work even when the api-server is slow/unreachable.
      //   Same shape as the legacy Flutter app used: a 2-way batch write
      //   into BOTH parties' `users/{uid}/requests/{otherUid}` docs.
      match /requests/{otherUid} {
        allow read: if isOwner(userId) && isVerifiedApp();
        allow write: if isAuthed() && (
          request.auth.uid == userId || request.auth.uid == otherUid
        );
      }

      // ----------------------------------------------------------
      //  users/{userId}/removals/{otherUid}
      // ----------------------------------------------------------
      // One-shot signal that a connection was removed (or the blocker
      // blocked the user). Owner-readable. Writes:
      //   - Create / update: only the OTHER party (otherUid). Path is
      //     users/{victim}/removals/{actor} so the actor IS otherUid
      //     here and writes the signal directly into the victim's
      //     subcollection. The victim's `subscribeToRemovals` listener
      //     picks it up and removes the encounter from their UI in
      //     real time.
      //   - Delete: only the owner (the victim) — used to clear
      //     processed signals locally if we ever wire that up.
      match /removals/{otherUid} {
        allow read: if isOwner(userId) && isVerifiedApp();
        allow create, update: if isVerifiedApp() && isAuthed() &&
          request.auth.uid == otherUid;
        allow delete: if isOwner(userId) && isVerifiedApp();
      }
    }

    // ------------------------------------------------------------
    //  chats/{chatId}
    // ------------------------------------------------------------
    // Real-time chat between two mutually-revealed (connected) users.
    // chatId = [uidA, uidB].sort().join("_").
    //
    // Security model: both participants have already completed a mutual
    // identity reveal, so reading/writing each other's messages carries
    // no additional information risk beyond what the reveal already exposed.
    match /chats/{chatId} {

      // Is the caller one of the two participants stored in the chat doc?
      //
      // Uses the `participants` array (written at chat creation time) rather
      // than parsing the chatId with a regex. This is exact — no wildcard
      // ambiguity — and also handles Apple Sign-In UIDs which contain a
      // literal dot that regex `.` would treat as "any character".
      //
      // NOTE: isVerifiedApp() (App Check) is intentionally omitted here —
      // same pattern as the requests/ subcollection. App Check tokens may
      // not be generated on all production devices (Play Integrity / App
      // Attest require Firebase Console configuration). Auth + UID-in-participants
      // is sufficient: callers must be signed in AND their UID must be one
      // of the two UIDs stored at chat creation, which is only known after a
      // mutual reveal.
      function callerIsParticipant() {
        return isAuthed() && request.auth.uid in resource.data.participants;
      }

      // Read chat meta doc (lastMessage, lastReadAt).
      // resource may be null on a read of a not-yet-existing doc (e.g. first
      // open before any message is sent), so fall back to the chatId regex
      // only in that narrow case.
      allow read: if isAuthed() && (
        resource == null ||
        request.auth.uid in resource.data.participants
      );

      // Create (first-ever message: batch-creates the chat doc with
      // a `participants` array). Verify the caller is in the list they're
      // writing — prevents fabricating a chat on behalf of someone else.
      allow create: if isAuthed() &&
        request.auth.uid in request.resource.data.participants;

      // Update (subsequent messages update lastMessage / lastReadAt).
      allow update: if callerIsParticipant();

      // Delete: never from client.
      allow delete: if false;

      // Individual chat messages — immutable once written.
      //
      // Two cases for participant check:
      //  A) Chat meta doc exists → read its participants array (exact match,
      //     handles Apple Sign-In UIDs that contain a literal dot).
      //  B) Chat meta doc doesn't exist yet (first-ever message, written
      //     before the meta doc is created) → fall back to chatId path check.
      //     The chatId regex is slightly loose for Apple UIDs (dot = wildcard)
      //     but only ever over-permits, never over-denies, and is correct for
      //     all standard Firebase Auth providers.
      match /messages/{msgId} {
        function msgCallerIsParticipant() {
          return isAuthed() && (
            exists(/databases/$(database)/documents/chats/$(chatId))
              ? request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
              : (chatId.matches(request.auth.uid + '_.*') ||
                 chatId.matches('.*_' + request.auth.uid))
          );
        }
        allow read: if msgCallerIsParticipant();
        allow create: if msgCallerIsParticipant() &&
          request.resource.data.from == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // ------------------------------------------------------------
    //  ble_detections/{id}
    // ------------------------------------------------------------
    // Written by the native BLE scanner (MetBleModule.kt / .swift)
    // when a peer hash is detected in the background. The Cloud
    // Function `onBleDetectionCreated` resolves the hashes to UIDs,
    // records the encounter in Postgres, mirrors to met_people, and
    // sends push notifications to both users.
    //
    // Security model:
    //   - Only an authenticated user may create a doc.
    //   - The doc's observerUid MUST match the writer's auth UID so
    //     a malicious client cannot spoof another user as the observer.
    //   - No client reads, updates, or deletes — the Cloud Function
    //     updates `processed:true` via the Admin SDK (bypasses rules).
    //
    // App Check is intentionally omitted here (same reasoning as
    // /chats/): the write originates from background native code where
    // an App Check token may not be available on every device/OS.
    match /ble_detections/{id} {
      allow create: if isAuthed() &&
        request.resource.data.observerUid == request.auth.uid;
      allow read, update, delete: if false;
    }

    // Default deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
