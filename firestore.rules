rules_version = '2';

// Met — Firestore security rules.
//
// Source-of-truth identity is Firebase Auth (request.auth.uid).
// All client writes that touch another user's data go through the
// api-server using the Admin SDK (which bypasses these rules).
//
// App Check enforcement for Firestore is configured at the Firebase service
// level (for example, in the Firebase Console). Security Rules do not expose
// request.app_check_token, so this file does not inspect an App Check field or
// change the project's service-level enforcement setting.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthed() { return request.auth != null; }
    function isOwner(userId) { return isAuthed() && request.auth.uid == userId; }

    // ------------------------------------------------------------
    //  users/{userId}
    // ------------------------------------------------------------
    // Profile/presence doc. Profile identity and visibility are mirrored
    // by the api-server. Clients may update only their own GPS-presence
    // fields; clients may turn isVisible off as a fail-safe but cannot turn
    // it back on directly in Firestore.
    match /users/{userId} {
      // Read: only if the target user has Ghost Mode off, or it's self.
      // Any visible presence document is readable by an authenticated app
      // user because the existing geohash range query needs collection reads.
      // The document is intentionally limited to uid, presence and visibility;
      // profile details and BLE hashes are served through the API instead.
      allow read: if isAuthed() && (
        resource.data.isVisible == true || isOwner(userId)
      );

      // A client may create only a suppression marker before its profile
      // mirror exists. Server/Admin paths are responsible for publishing the
      // first visible presence document.
      allow create: if isOwner(userId) &&
        request.resource.data.uid == userId &&
        request.resource.data.keys().hasOnly(['uid', 'isVisible']) &&
        request.resource.data.isVisible == false;

      // Updates are presence-only. A client can fail-safe hide itself, but
      // cannot turn visibility on; only the API server may publish it.
      // Presence can be published only while both the current canonical
      // visibility and the resulting visibility are true. Hidden clients may
      // still clear stale presence fields or turn visibility off.
      allow update: if isOwner(userId) &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'location', 'geohash', 'lastActive', 'isVisible'
        ]) &&
        (
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['location', 'geohash', 'lastActive']) ||
          (
            resource.data.isVisible == true &&
            request.resource.data.isVisible == true
          ) ||
          (
            (
              !request.resource.data.diff(resource.data)
                .affectedKeys().hasAny(['location']) ||
              !('location' in request.resource.data) ||
              request.resource.data.location == null
            ) &&
            (
              !request.resource.data.diff(resource.data)
                .affectedKeys().hasAny(['geohash']) ||
              !('geohash' in request.resource.data) ||
              request.resource.data.geohash == null
            ) &&
            (
              !request.resource.data.diff(resource.data)
                .affectedKeys().hasAny(['lastActive']) ||
              !('lastActive' in request.resource.data) ||
              request.resource.data.lastActive == null
            )
          )
        ) &&
        (
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['isVisible']) ||
          request.resource.data.isVisible == false
        );

      // Delete: never from client. Use api-server admin path.
      allow delete: if false;

      // ----------------------------------------------------------
      //  users/{userId}/met_people/{otherUid}
      // ----------------------------------------------------------
      // Encounter history. Reads are owner-only.
      //
      // Create / update: server-only (api-server via Admin SDK writes
      // these when two users actually cross paths — the client doesn't
      // get to fabricate met_people docs).
      //
      // Delete: allowed for EITHER party. This is the resilience path
      // for Remove / Block — when user A removes user B, A wipes both
      // sides' met_people docs in a single client batch so B's
      // encounter list updates immediately even if the api-server is
      // slow / unreachable. Mirrors the legacy Flutter app's batch.
      match /met_people/{otherUid} {
        allow read: if isOwner(userId);
        allow create, update: if false;
        allow delete: if isAuthed() && (
          request.auth.uid == userId || request.auth.uid == otherUid
        );
      }

      // ----------------------------------------------------------
      //  users/{userId}/requests/{otherUid}
      // ----------------------------------------------------------
      // Reveal-request handshake. Reads are owner-only.
      //
      // The api-server (Admin SDK) is the canonical creator of request mirrors.
      // Clients may only apply a pending response from the actual recipient;
      // identity and direction fields are immutable. Either party may still
      // delete their pair's copy for the existing Remove / Block resilience path.
      match /requests/{otherUid} {
        allow read: if isOwner(userId);
        allow create: if false;
        allow update: if isAuthed() &&
          resource.data.peerUid == otherUid &&
          (
            (
              resource.data.direction == 'inbound' &&
              request.auth.uid == userId
            ) ||
            (
              resource.data.direction == 'outbound' &&
              request.auth.uid == otherUid
            )
          ) &&
          resource.data.status == 'pending' &&
          request.resource.data.status in ['accepted', 'declined'] &&
          request.resource.data.peerUid == resource.data.peerUid &&
          request.resource.data.direction == resource.data.direction &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'updatedAt', 'respondedAt'
          ]);
        allow delete: if isAuthed() && (
          request.auth.uid == userId || request.auth.uid == otherUid
        );
      }

      // ----------------------------------------------------------
      //  users/{userId}/removals/{otherUid}
      // ----------------------------------------------------------
      // One-shot signal that a connection was removed (or the blocker
      // blocked the user). Owner-readable. Writes:
      //   - Create / update: only the OTHER party (otherUid). Path is
      //     users/{victim}/removals/{actor} so the actor IS otherUid
      //     here and writes the signal directly into the victim's
      //     subcollection. The victim's `subscribeToRemovals` listener
      //     picks it up and removes the encounter from their UI in
      //     real time.
      //   - Delete: only the owner (the victim) — used to clear
      //     processed signals locally if we ever wire that up.
      match /removals/{otherUid} {
        allow read: if isOwner(userId);
        allow create, update: if isAuthed() &&
          request.auth.uid == otherUid;
        allow delete: if isOwner(userId);
      }
    }

    // ------------------------------------------------------------
    //  chats/{chatId}
    // ------------------------------------------------------------
    // Real-time chat between two mutually-revealed (connected) users.
    // chatId = [uidA, uidB].sort().join("_").
    //
    // Security model: both participants have already completed a mutual
    // identity reveal, so reading/writing each other's messages carries
    // no additional information risk beyond what the reveal already exposed.
    match /chats/{chatId} {

      // Legacy chat IDs were generated from two sorted UIDs joined by "_".
      // Only accept that fallback when the ID has exactly two components and
      // is canonical; ambiguous IDs must rely on the explicit participants
      // array instead of accidentally treating a UID fragment as a member.
      function legacyChatIdHasCaller(uid) {
        let parts = chatId.split('_');
        return parts.size() == 2 &&
          parts[0] <= parts[1] &&
          (uid == parts[0] || uid == parts[1]);
      }

      function chatDataHasCaller(chatData) {
        return (
          ('participants' in chatData &&
           request.auth.uid in chatData.participants) ||
          (!('participants' in chatData) &&
           legacyChatIdHasCaller(request.auth.uid))
        );
      }

      // Is the caller one of the participants stored in this chat, or one of
      // the pair encoded in an unambiguous legacy chat ID?
      function callerIsParticipant() {
        return isAuthed() && chatDataHasCaller(resource.data);
      }

      // Read chat meta doc (lastMessage, lastReadAt).
      // A missing doc is permitted for the initial conversation view.
      allow read: if isAuthed() && (
        resource == null ||
        callerIsParticipant()
      );

      // First message creates the chat doc with a participants array.
      allow create: if isAuthed() &&
        request.auth.uid in request.resource.data.participants;

      // Existing participant behavior retained for backwards compatibility.
      allow update: if callerIsParticipant();

      // Delete: never from client.
      allow delete: if false;

      // Individual chat messages.
      // Caller must be authenticated, the message's `from` field must
      // match the caller's UID, and the caller must be a participant.
      // No turn-taking restriction — either participant may send freely.
      match /messages/{msgId} {
        // `resource` here is the message, not the parent chat. Resolve the
        // parent explicitly so message access is tied to actual participation.
        function callerIsParentChatParticipant() {
          let chatPath = /databases/$(database)/documents/chats/$(chatId);
          return isAuthed() && exists(chatPath) &&
            chatDataHasCaller(get(chatPath).data);
        }

        // The first message and its chat metadata may be committed together;
        // use the post-write parent only for create authorization.
        function callerIsParentChatParticipantAfterWrite() {
          let chatPath = /databases/$(database)/documents/chats/$(chatId);
          return isAuthed() && existsAfter(chatPath) &&
            chatDataHasCaller(getAfter(chatPath).data);
        }

        allow read: if callerIsParentChatParticipant();
        allow create: if isAuthed() &&
          request.resource.data.from == request.auth.uid &&
          callerIsParentChatParticipantAfterWrite();

        // Soft-delete: only the original sender may set deleted=true,
        // and ONLY that field may change (no other field mutations).
        allow update: if isAuthed() && (
          // Sender soft-deleting their own message
          (resource.data.from == request.auth.uid &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted']) &&
           request.resource.data.deleted == true) ||
          // Any participant updating reactions only
          (callerIsParentChatParticipant() &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']))
        );

        allow delete: if false;
      }
    }

    // ------------------------------------------------------------
    //  ble_detections/{id}
    // ------------------------------------------------------------
    // Written by the native BLE scanner (MetBleModule.kt / .swift)
    // when a peer hash is detected in the background. The Cloud
    // Function `onBleDetectionCreated` resolves the hashes to UIDs,
    // records the encounter in Postgres, mirrors to met_people, and
    // sends push notifications to both users.
    //
    // Security model:
    //   - Only an authenticated user may create a doc.
    //   - The doc's observerUid MUST match the writer's auth UID so
    //     a malicious client cannot spoof another user as the observer.
    //   - No client reads, updates, or deletes — the Cloud Function
    //     updates `processed:true` via the Admin SDK (bypasses rules).
    //
    // App Check is intentionally omitted here (same reasoning as
    // /chats/): the write originates from background native code where
    // an App Check token may not be available on every device/OS.
    match /ble_detections/{id} {
      allow create: if isAuthed() &&
        request.resource.data.observerUid == request.auth.uid;
      allow read, update, delete: if false;
    }

    // Default deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
