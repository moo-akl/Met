rules_version = '2';

// Met — Firestore security rules.
//
// Source-of-truth identity is Firebase Auth (request.auth.uid).
// All client writes that touch another user's data go through the
// api-server using the Admin SDK (which bypasses these rules).
//
// In production we require a valid App Check token on every request.
// During development we relax that check via a project env var.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthed() { return request.auth != null; }
    function isOwner(userId) { return isAuthed() && request.auth.uid == userId; }

    // App Check: every read / write must carry a valid App Check token.
    // The mobile client initialises App Check at boot via
    // `lib/firestore/client.ts` (debug provider in __DEV__, Play
    // Integrity / App Attest in release), so dev and production both
    // satisfy this gate.
    function isVerifiedApp() {
      return request.app_check_token != null;
    }

    // ------------------------------------------------------------
    //  users/{userId}
    // ------------------------------------------------------------
    // Profile doc. Mirrored from Postgres by the api-server when the
    // user updates their profile, OR self-updated by the client for
    // mutable fields (location, lastActive, isVisible).
    match /users/{userId} {
      // Read: only if the target user has Ghost Mode off, or it's self.
      // Note: any visible profile is currently readable by any authed
      // user (the geohash range query needs broad reads). Sensitive
      // fields like `socials` and `bio` are still in this doc — a
      // future hardening pass should split the doc into a public
      // `presence` subset (uid, geohash, isVisible) and a private
      // `profile` subset gated on a per-pair handshake.
      allow read: if isAuthed() && isVerifiedApp() && (
        resource.data.isVisible == true || isOwner(userId)
      );

      // Create: only the user themselves, and the doc must contain at
      // least a uid that matches.
      allow create: if isOwner(userId) && isVerifiedApp() &&
        request.resource.data.uid == userId;

      // Update: owner only, and certain immutable fields cannot change.
      allow update: if isOwner(userId) && isVerifiedApp() &&
        request.resource.data.uid == resource.data.uid;

      // Delete: never from client. Use api-server admin path.
      allow delete: if false;

      // ----------------------------------------------------------
      //  users/{userId}/met_people/{otherUid}
      // ----------------------------------------------------------
      // Encounter history. Reads are owner-only. Writes happen
      // exclusively from the api-server via Admin SDK (rules bypassed),
      // so client writes are blocked.
      match /met_people/{otherUid} {
        allow read: if isOwner(userId) && isVerifiedApp();
        allow write: if false;
      }

      // ----------------------------------------------------------
      //  users/{userId}/requests/{otherUid}
      // ----------------------------------------------------------
      // Reveal-request handshake. Reads are owner-only.
      //
      // Writes:
      // - The api-server (Admin SDK) bypasses these rules and is still
      //   the canonical writer for full-fidelity mirrors.
      // - From the client we ALSO allow either party to update the doc:
      //     * the owner (userId) — for their own outbox/inbox doc, AND
      //     * the OTHER party (otherUid) — so the recipient can flip the
      //       sender's outbox doc to "accepted" / "declined" without a
      //       server round-trip. This is the resilience path that makes
      //       accept work even when the api-server is slow/unreachable.
      //   Same shape as the legacy Flutter app used: a 2-way batch write
      //   into BOTH parties' `users/{uid}/requests/{otherUid}` docs.
      match /requests/{otherUid} {
        allow read: if isOwner(userId) && isVerifiedApp();
        allow write: if isVerifiedApp() && isAuthed() && (
          request.auth.uid == userId || request.auth.uid == otherUid
        );
      }

      // ----------------------------------------------------------
      //  users/{userId}/removals/{otherUid}
      // ----------------------------------------------------------
      // One-shot signal that a connection was removed (by either
      // party). Owner-readable; the api-server is the sole writer
      // via the Admin SDK so client writes are blocked.
      match /removals/{otherUid} {
        allow read: if isOwner(userId) && isVerifiedApp();
        allow write: if false;
      }
    }

    // Default deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
